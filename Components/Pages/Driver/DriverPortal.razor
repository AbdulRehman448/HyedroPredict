@page "/driver/dashboard"
@using HydroPredict.Models
@implements IDisposable
@using HydroPredict.Services.Interfaces
@rendermode InteractiveServer
@inject IDashboardService DashboardService
@inject HydroPredict.Data.ApplicationDbContext DbContext
@inject HydroPredict.Services.Implementations.UiStateService UiState

<div class="container py-4">
    <div class="p-4 rounded-4 mb-4 shadow-sm @(UiState.IsDarkMode ? "bg-secondary text-white" : "bg-white text-dark")">
        <h4 class="fw-bold mb-0">@UiState.T("driver_portal")</h4>
        <p class="text-muted small mb-0">Inspect delivery routes and print tracking bills.</p>
    </div>

    <div class="card border-0 p-4 shadow-sm rounded-4 @(UiState.IsDarkMode ? "bg-dark text-white" : "bg-white text-dark")">
        <h5 class="fw-bold mb-3"><i class="bi bi-truck text-info me-2"></i>Active Manifest Logistics Sheets</h5>
        <div class="table-responsive">
            <table class="table align-middle border-0">
                <thead class="table-light small">
                    <tr>
                        <th>Manifest ID</th>
                        <th>@UiState.T("customer")</th>
                        <th>@UiState.T("address")</th>
                        <th>@UiState.T("tariff")</th>
                        <th class="text-end">@UiState.T("actions")</th>
                    </tr>
                </thead>
                <tbody class="small text-secondary">
                    @foreach (var job in _assignedJobs)
                    {
                        var customerName = _userMap.ContainsKey(job.UserId) ? _userMap[job.UserId] : "Loading Customer...";
                        <tr>
                            <td class="fw-bold text-primary">#HP-@job.Id</td>
                            <td class="text-dark fw-medium">@customerName</td>
                            <td>@job.DeliveryAddress</td>
                            <td class="fw-bold text-success">Rs. @job.DynamicTariffCalculated.ToString("N2")</td>
                            <td class="text-end">
                                @if (job.ManifestStatus == BookingStatus.ApprovedAndAssigned)
                                {
                                    <button class="btn btn-sm btn-primary fw-semibold rounded-3 px-3" @onclick="() => ProgressState(job.Id, BookingStatus.InTransit)">Depart</button>
                                }
                                else if (job.ManifestStatus == BookingStatus.InTransit)
                                {
                                    <button class="btn btn-sm btn-success fw-semibold rounded-3 px-3" @onclick="() => ProgressState(job.Id, BookingStatus.Delivered)">Complete</button>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">@job.ManifestStatus.ToString()</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<Booking> _assignedJobs = new();
    private Dictionary<int, string> _userMap = new();
    private const int SimulatedDriverId = 2;

    protected override async Task OnInitializedAsync() { UiState.OnChange += StateHasChanged; await LoadJobs(); }
    private async Task LoadJobs()
    {
        var res = await DashboardService.GetAllBookingsAsync();
        _assignedJobs = res.Where(b => b.AssignedDriverId == SimulatedDriverId).ToList();
        foreach (var j in _assignedJobs)
        {
            if (!_userMap.ContainsKey(j.UserId))
            {
                var u = await DbContext.Users.FindAsync(j.UserId);
                if (u != null) _userMap[j.UserId] = u.AccountName;
            }
        }
    }
    private async Task ProgressState(int bId, BookingStatus s) { await DashboardService.UpdateBookingStatusAsync(bId, s); await LoadJobs(); }
    public void Dispose() => UiState.OnChange -= StateHasChanged;
}